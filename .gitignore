# Keep the GitHub push SMALL (~25 MB): the runner re-downloads the AOSP
# source itself. Only .github/ + device/vivo/y52s/ + the top-level docs are
# needed in the remote repository.
#
# Excluded on purpose (all local evidence / artefacts, several GB total):
device_dump/
src/
.workbuddy/
build/*
!build/compile_twrp.sh
!build/extract_prebuilt.py
!build/build_recovery.py
!build/extract_crypto_libs.py
!build/inspect_reference.py
!build/fetch_parallel.py
!build/inspect_ci_image.py
!build/postprocess_ci.py
!build/make_hybrid.py
!build/port_y73s.py
!flash/flash_and_verify.ps1
!flash/verify_twrp.sh

# Never upload secrets, credentials or private keys.
*.pem
*.key
*.keystore
.git-credentials
.env
*token*
!flash/adb_fix.ps1
!flash/verify_and_return.ps1
!flash/fix_boot_loop.sh
!build/use_vivo_vbmeta.py
!build/y52s_boot_hdr.bin
!flash/recover.ps1
!flash/recover_clear_bcb.sh
!flash/probe_decrypt.sh
!flash/probe_keys.sh
!flash/probe_hal.sh
!flash/probe_km_tail.sh
!flash/verify_decrypt.sh
reference/y52s_official_recovery.img
!build/make_official_hybrid.py
!flash/verify_final.sh
!flash/verify_features.sh
