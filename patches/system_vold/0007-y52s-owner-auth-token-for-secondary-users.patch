-			printf("[SECDIS] Gatekeeper verification succeeded\n");
+			printf("[SECDIS] Gatekeeper verification succeeded\n");
+
+			// y52s: secondary users (e.g. vivo DOUBLE_APP user 999) keep their
+			// synthetic-password key in the OWNER's keystore namespace and it is
+			// bound to the OWNER's gatekeeper SID. Replace the profile token with
+			// the owner's token before unwrapSyntheticPasswordBlob() reads
+			// /auth_token. Without this keymaster returns -26.
+			if (user_id != 0) {
+				if (!Write_Owner_Auth_Token(Password))
+					printf("y52s: owner token unavailable, keeping profile token\n");
+			}
 		}
