+/* ===========================================================================
+ * y52s / PD2057 -- AOSP "tied profile" (unified challenge) credential.
+ *
+ * LockSettingsService.tieManagedProfileLockIfNecessary() (Android 10):
+ *   randomLockSeed = SecureRandom("SHA1PRNG").generateSeed(40)
+ *   newPassword    = HexEncoding.encode(randomLockSeed)   -> 80 ASCII chars
+ *   setLockCredentialInternal(newPassword, PASSWORD, ..., profileId)
+ *   tieProfileLockToParent(profileId, newPassword)
+ * The profile's SP is therefore bound to a RANDOM 80-char password the user
+ * never sees. It is AES-256-GCM encrypted under an auth-bound AndroidKeystore
+ * key aliased "profile_key_name_decrypt_<userId>" and stored as
+ *   /data/system/users/<userId>/gatekeeper.profile.key = IV(12) || ct || tag
+ * getDecryptedPasswordForTiedProfile() decrypts it with the OWNER's auth
+ * token -- exactly the 69-byte HW_AUTH_TOKEN TWRP writes to /auth_token when
+ * user 0 is decrypted.
+ *
+ * TWRP never implemented this path: it only tries the owner PIN and "!", both
+ * of which fail gatekeeper verify against the profile's own .pwd.
+ * =========================================================================== */
+static std::string Get_Tied_Profile_Password(const userid_t user_id) {
+	using android::vold::km::AuthorizationSetBuilder;
+	using android::vold::km::TAG_PURPOSE;
+	using android::vold::km::TAG_ALGORITHM;
+	using android::vold::km::TAG_BLOCK_MODE;
+	using android::vold::km::TAG_PADDING;
+	using android::vold::km::TAG_NONCE;
+	using android::vold::km::TAG_MAC_LENGTH;
+	using android::vold::km::KeyPurpose;
+	using android::vold::km::Algorithm;
+	using android::vold::km::BlockMode;
+	using android::vold::km::PaddingMode;
+	using android::vold::Keymaster;
+	using android::vold::KeymasterOperation;
+
+	char lock_path[PATH_MAX];
+	snprintf(lock_path, sizeof(lock_path),
+		"/data/system/users/%d/gatekeeper.profile.key", (int)user_id);
+	std::string stored;
+	if (!android::base::ReadFileToString(lock_path, &stored) || stored.size() < 29) {
+		printf("y52s: no tied-profile lock file %s\n", lock_path);
+		return "";
+	}
+	const std::string nonce = stored.substr(0, 12);
+	const std::string ciphertext = stored.substr(12);
+
+	char key_path[PATH_MAX];
+	snprintf(key_path, sizeof(key_path),
+		"/data/misc/keystore/user_0/1000_USRPKEY_profile_key_name_decrypt_%d", (int)user_id);
+	std::string key_blob;
+	if (!android::base::ReadFileToString(key_path, &key_blob) || key_blob.empty()) {
+		printf("y52s: no tied-profile keystore key %s\n", key_path);
+		return "";
+	}
+
+	Keymaster keymaster;
+	if (!keymaster) {
+		printf("y52s: keymaster device unavailable for tied profile\n");
+		return "";
+	}
+	// Android 10 keystore blob: 40-byte header followed by the raw
+	// keymaster blob (same layout as the synthetic_password_* blobs).
+	std::string km_blob;
+	const size_t offsets[] = {40, 0, 4, 44};
+	for (size_t off : offsets) {
+		if (key_blob.size() <= off + 16) continue;
+		std::string cand = key_blob.substr(off);
+		android::vold::km::AuthorizationSet hw, sw;
+		if (keymaster.getKeyCharacteristics(cand, &hw, &sw)) {
+			km_blob = cand;
+			printf("y52s: tied-profile key blob at offset %zu (%zu bytes)\n", off, km_blob.size());
+			break;
+		}
+	}
+	if (km_blob.empty()) {
+		printf("y52s: tied-profile key blob not usable\n");
+		return "";
+	}
+
+	std::string tok;
+	if (!android::base::ReadFileToString("/auth_token", &tok) || tok.size() < 69) {
+		printf("y52s: no owner auth token for tied-profile key\n");
+		return "";
+	}
+	/* ======================================================================
+	 * y52s: ONE build, every remaining hypothesis.
+	 *
+	 * All material needed for the tied-profile credential is readable in TWRP
+	 * (measured). The only unknown is the exact byte interpretation of the
+	 * 69-byte hw_auth_token_t that Trustonic's keymaster expects for an
+	 * AUTH-BOUND key. Each previous round tested ONE interpretation per
+	 * 30-minute cloud build. This table exhausts 4 independent bits at
+	 * runtime (16 combinations) plus a no-token begin(), logs every error
+	 * code, and the FIRST strategy that succeeds continues straight to
+	 * update/finish -- so one PIN entry both diagnoses AND fixes user 999.
+	 *
+	 *   bit0 be64     : byte-swap challenge / authenticatorId
+	 *   bit1 be32     : byte-swap authenticatorType (== ntohl)
+	 *   bit2 ts_alt   : invert the timestamp byte-swap choice
+	 *   bit3 u_alt    : invert the userId byte-swap choice
+	 *   strategy 16   : begin() WITHOUT any auth token
+	 *
+	 * /tmp/y52s_km_only with a number 0..16 restricts the run to one
+	 * strategy: further experiments need only `adb shell echo N >
+	 * /tmp/y52s_km_only` + `twrp decrypt <PIN> 999`, NOT another build.
+	 *
+	 * REGRESSION GUARD: the upstream unwrapSyntheticPasswordBlob() parser
+	 * above is deliberately untouched. run 42751657966 proved that changing
+	 * it makes user 0 fail with -26 too.
+	 * ====================================================================== */
+	typedef android::hardware::keymaster::V4_0::HardwareAuthToken HAT;
+	typedef android::hardware::keymaster::V4_0::HardwareAuthenticatorType HAType;
+
+	auto swap64 = [](uint64_t v) -> uint64_t {
+		return ((v & 0x00000000000000FFULL) << 56) |
+		       ((v & 0x000000000000FF00ULL) << 40) |
+		       ((v & 0x0000000000FF0000ULL) << 24) |
+		       ((v & 0x00000000FF000000ULL) << 8)  |
+		       ((v & 0x000000FF00000000ULL) >> 8)  |
+		       ((v & 0x0000FF0000000000ULL) >> 24) |
+		       ((v & 0x00FF000000000000ULL) >> 40) |
+		       ((v & 0xFF00000000000000ULL) >> 56);
+	};
+	auto swap32 = [](uint32_t v) -> uint32_t {
+		return ((v & 0x000000FFU) << 24) | ((v & 0x0000FF00U) << 8) |
+		       ((v & 0x00FF0000U) >> 8) | ((v & 0xFF000000U) >> 24);
+	};
+	auto sw64 = [&](uint64_t v, bool do_swap) -> uint64_t {
+		return do_swap ? swap64(v) : v;
+	};
+
+	const uint8_t* p = (const uint8_t*)tok.data();
+	uint64_t c_raw, u_raw, a_raw, ts_raw;
+	uint32_t ty_raw;
+	memcpy(&c_raw,  p + 1,  8);
+	memcpy(&u_raw,  p + 9,  8);
+	memcpy(&a_raw,  p + 17, 8);
+	memcpy(&ty_raw, p + 25, 4);
+	memcpy(&ts_raw, p + 29, 8);
+	printf("y52s: raw token fields c=0x%llx u=0x%llx a=0x%llx ty=0x%x ts=0x%llx\n",
+		(unsigned long long)c_raw, (unsigned long long)u_raw,
+		(unsigned long long)a_raw, (unsigned int)ty_raw,
+		(unsigned long long)ts_raw);
+
+	int only = -1;
+	std::string only_str;
+	if (android::base::ReadFileToString("/tmp/y52s_km_only", &only_str)) {
+		int val = 0; bool got = false;
+		for (char ch : only_str) {
+			if (ch >= '0' && ch <= '9') { val = val * 10 + (ch - '0'); got = true; }
+			else if (got) break;
+		}
+		if (got && val <= 16) { only = val; printf("y52s: strategy override: only %d\n", only); }
+	}
+
+	std::vector<uint8_t> nonce_vec(nonce.begin(), nonce.end());
+	for (int strategy = 0; strategy <= 16; ++strategy) {
+		if (only >= 0 && strategy != only) continue;
+		const bool be64   = (strategy & 1) != 0;
+		const bool be32   = (strategy & 2) != 0;
+		const bool ts_alt = (strategy & 4) != 0;
+		const bool u_alt  = (strategy & 8) != 0;
+		const bool no_token = (strategy == 16);
+
+		auto params = AuthorizationSetBuilder()
+			.Authorization(TAG_PURPOSE, KeyPurpose::DECRYPT)
+			.Authorization(TAG_ALGORITHM, Algorithm::AES)
+			.Authorization(TAG_BLOCK_MODE, BlockMode::GCM)
+			.Authorization(TAG_PADDING, PaddingMode::NONE)
+			.Authorization(TAG_NONCE, nonce_vec)
+			.Authorization(TAG_MAC_LENGTH, 128);
+		android::vold::km::AuthorizationSet outParams;
+		KeymasterOperation op;
+		if (no_token) {
+			printf("y52s: strategy 16: begin() WITHOUT auth token\n");
+			op = keymaster.begin(km_blob, params, &outParams);
+		} else {
+			HAT token;
+			token.challenge       = sw64(c_raw,  be64);
+			token.userId          = sw64(u_raw,  (bool)(be64 ^ u_alt));
+			token.authenticatorId = sw64(a_raw,  be64);
+			token.authenticatorType = static_cast<HAType>(be32 ? swap32(ty_raw) : ty_raw);
+			token.timestamp       = sw64(ts_raw, (bool)(be64 ^ ts_alt));
+			token.mac.resize(32);
+			memcpy(token.mac.data(), p + 37, 32);
+			printf("y52s: strategy %d [be64=%d be32=%d ts_alt=%d u_alt=%d] "
+			       "userId=0x%llx type=%u ts=%llu\n",
+				strategy, (int)be64, (int)be32, (int)ts_alt, (int)u_alt,
+				(unsigned long long)token.userId,
+				(unsigned int)token.authenticatorType,
+				(unsigned long long)token.timestamp);
+			op = keymaster.begin(km_blob, params, &outParams, token);
+		}
+		if (!op) {
+			printf("y52s: strategy %d begin failed: %d\n", strategy, (int)op.getErrorCode());
+			continue;
+		}
+		std::string plain, tail;
+		if (!op.updateCompletely(ciphertext, &plain)) {
+			printf("y52s: strategy %d update failed\n", strategy);
+			continue;
+		}
+		if (!op.finish(&tail)) {
+			printf("y52s: strategy %d finish failed\n", strategy);
+			continue;
+		}
+		plain += tail;
+		printf("y52s: STRATEGY %d SUCCEEDED, credential recovered (%zu bytes)\n",
+			strategy, plain.size());
+		return plain;
+	}
+	printf("y52s: all strategies exhausted for tied-profile credential\n");
+	return "";
+}
