+/* AOSP AuthenticationToken.deriveGkPassword() derives the gatekeeper input
+ * from the SYNTHETIC PASSWORD, never from the lock credential:
+ *   v3: new SP800Derive(sp).withContext("sp-gk-authentication",
+ *           "android-synthetic-password-personalization-context")
+ *   v2: personalisedHash("sp-gk-authentication", sp)
+ * The v3 form is the same call that already produces this device's disk
+ * decryption key (PersonalizedHashSP800(FBE_KEY, CONTEXT, ...)), so only the
+ * label is new here; both label and context are AOSP constants. */
+static bool Y52s_Mint_Sid_Token(const userid_t owner_id, uint64_t want_sid,
+		std::string* token_out) {
+	if (g_y52s_sp.empty() || g_y52s_sp_user != owner_id) {
+		printf("y52s: sid token: no synthetic password for user %d\n",
+		       (int)owner_id);
+		return false;
+	}
+	std::string gk_input;
+	if (g_y52s_sp_v3)
+		gk_input = PersonalizedHashSP800("sp-gk-authentication",
+				PERSONALISATION_CONTEXT, g_y52s_sp.data(),
+				(int)g_y52s_sp.size());
+	else
+		gk_input = PersonalizedHash("sp-gk-authentication",
+				g_y52s_sp.data(), (int)g_y52s_sp.size());
+	if (gk_input.empty()) {
+		printf("y52s: sid token: gatekeeper input derivation failed\n");
+		return false;
+	}
+	std::vector<Y52sHandleCand> cands;
+	Y52s_Collect_Handles(&cands);
+	for (size_t i = 0; i < cands.size(); ++i) {
+		if (cands[i].user != owner_id)
+			continue;
+		const uint64_t sid = Y52s_Sid_Of_Handle(cands[i].bytes);
+		if (want_sid != 0 && sid != want_sid) {
+			printf("y52s: sid token: %s carries sid=0x%llx (key wants 0x%llx)\n",
+			       cands[i].path.c_str(), (unsigned long long)sid,
+			       (unsigned long long)want_sid);
+			continue;
+		}
+		std::string tok;
+		if (Y52s_Gk_Verify(owner_id, /*real_uid=*/true, cands[i].path,
+				cands[i].bytes, gk_input, &tok)) {
+			g_y52s_sid_token = tok;
+			g_y52s_sid_token_sid = sid;
+			g_y52s_sid_token_user = owner_id;
+			printf("y52s: sid token: minted for sid=0x%llx (user %d)\n",
+			       (unsigned long long)sid, (int)owner_id);
+			if (token_out)
+				*token_out = tok;
+			return true;
+		}
+	}
+	printf("y52s: sid token: no enrolment accepted the synthetic password\n");
+	return false;
+}
