 /* Mint a token for want_sid by verifying the enrolled handle that carries it
  * with the owner credential. Returns the raw 69-byte token. */
 static bool Y52s_Mint_Token(const userid_t owner_id, const std::string& credential,
 		uint64_t want_sid, std::string* token_out) {
+	/* 1. A token already minted from this user's synthetic password. */
+	if (!g_y52s_sid_token.empty() && g_y52s_sid_token_user == owner_id &&
+	    (want_sid == 0 || g_y52s_sid_token_sid == want_sid)) {
+		printf("y52s: mint: reusing the SID token (sid=0x%llx)\n",
+		       (unsigned long long)g_y52s_sid_token_sid);
+		if (token_out)
+			*token_out = g_y52s_sid_token;
+		return true;
+	}
+	/* 2. Mint one from the synthetic password -- the secret the escrow key of
+	 *    an app clone is actually bound to.  If the owner was not unlocked in
+	 *    this run, unlock it first with the same credential: AOSP requires the
+	 *    parent to be unlocked before a tied profile can be. */
+	if (g_y52s_sp_user != owner_id && !credential.empty() && credential != "!") {
+		printf("y52s: mint: no synthetic password yet, unlocking user %d\n",
+		       (int)owner_id);
+		Decrypt_User_Synth_Pass(owner_id, credential);
+	}
+	if (!g_y52s_sp.empty() && g_y52s_sp_user == owner_id &&
+	    Y52s_Mint_Sid_Token(owner_id, want_sid, token_out))
+		return true;
