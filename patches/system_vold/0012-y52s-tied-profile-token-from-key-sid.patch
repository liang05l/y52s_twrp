+/* ---------------------------------------------------------------------------
+ * y52s / PD2057 -- mint a REAL gatekeeper auth token for the SID a keystore
+ * key is bound to.
+ *
+ * A key states the SID it accepts in its own authorization set
+ * (KM_TAG_USER_SECURE_ID, 502), so nothing below is guessed or hardcoded:
+ *   - the SID comes from getKeyCharacteristics() of the very key we must open,
+ *   - the candidate gatekeeper handles are enumerated from /data/system_de,
+ *   - only the enrolment that carries that SID is verified, and
+ *   - the token reaches begin() exactly as gatekeeper produced it.
+ * The last point is the crux: the HMAC covers userId, so rewriting userId in
+ * a token that was minted for a different enrolment can never authenticate
+ * (that is why the previous 17-combination table lost every time).
+ * ------------------------------------------------------------------------- */
+
+static uint64_t Y52s_Swap64(uint64_t v) {
+	return ((v & 0x00000000000000FFULL) << 56) |
+	       ((v & 0x000000000000FF00ULL) << 40) |
+	       ((v & 0x0000000000FF0000ULL) << 24) |
+	       ((v & 0x00000000FF000000ULL) << 8)  |
+	       ((v & 0x000000FF00000000ULL) >> 8)  |
+	       ((v & 0x0000FF0000000000ULL) >> 24) |
+	       ((v & 0x00FF000000000000ULL) >> 40) |
+	       ((v & 0xFF00000000000000ULL) >> 56);
+}
+
+/* A gatekeeper password handle stores its secure id as the first eight bytes
+ * of the opaque handle body; that is the value keystore copies into the key's
+ * USER_SECURE_ID, verified on this device against two independent keys. */
+static uint64_t Y52s_Sid_Of_Handle(const std::string& handle) {
+	if (handle.size() < 9)
+		return 0;
+	uint64_t sid = 0;
+	memcpy(&sid, handle.data() + 1, 8);
+	return sid;
+}
+
+/* hw_auth_token_t (69 bytes): version(1) challenge(8) user_id(8)
+ * authenticator_id(8) authenticator_type(4) timestamp(8) hmac(32).
+ * Decoded exactly like unwrapSyntheticPasswordBlob() does -- that decoder is
+ * proven on this device because it is what makes the owner's begin() work. */
+static bool Y52s_Parse_Token(const std::string& raw,
+		android::hardware::keymaster::V4_0::HardwareAuthToken* out) {
+	using android::hardware::keymaster::V4_0::HardwareAuthenticatorType;
+	if (raw.size() < 69)
+		return false;
+	const uint8_t* p = (const uint8_t*)raw.data() + 1;
+	memcpy(&out->challenge, p, 8); p += 8;
+	memcpy(&out->userId, p, 8); p += 8;
+	memcpy(&out->authenticatorId, p, 8); p += 8;
+	uint32_t type = 0;
+	memcpy(&type, p, 4); p += 4;
+	out->authenticatorType = static_cast<HardwareAuthenticatorType>(ntohl(type));
+	uint64_t ts = 0;
+	memcpy(&ts, p, 8); p += 8;
+	out->timestamp = Y52s_Swap64(ts);
+	out->mac.resize(32);
+	memcpy(out->mac.data(), p, 32);
+	return true;
+}
+
+static bool Y52s_Gk_Verify(const userid_t user_id, const std::string& what,
+		const std::string& handle, const std::string& gk_password,
+		std::string* token_out) {
+	using android::hardware::gatekeeper::V1_0::IGatekeeper;
+	using android::hardware::gatekeeper::V1_0::GatekeeperResponse;
+	using android::hardware::gatekeeper::V1_0::GatekeeperStatusCode;
+
+	android::sp<IGatekeeper> gk = IGatekeeper::getService();
+	if (gk == nullptr) {
+		printf("y52s: gk verify: gatekeeper HAL unavailable\n");
+		return false;
+	}
+	android::hardware::hidl_vec<uint8_t> handle_vec;
+	handle_vec.setToExternal(const_cast<uint8_t*>((const uint8_t*)handle.data()),
+			handle.size());
+	android::hardware::hidl_vec<uint8_t> pwd_vec;
+	pwd_vec.setToExternal(const_cast<uint8_t*>((const uint8_t*)gk_password.data()),
+			gk_password.size());
+
+	int code = -1;
+	uint32_t timeout = 0;
+	std::string token;
+	auto take = [&code, &timeout, &token](const GatekeeperResponse& rsp) {
+		code = (int)rsp.code;
+		timeout = rsp.timeout;
+		if (rsp.code >= GatekeeperStatusCode::STATUS_OK)
+			token.assign((const char*)rsp.data.data(), rsp.data.size());
+	};
+	android::hardware::Return<void> hr = gk->verify(
+			fakeUid(user_id), 0 /* challenge */, handle_vec, pwd_vec, take);
+	printf("y52s: gk verify %s: sid=0x%llx call_ok=%d code=%d timeout=%u token=%zu\n",
+	       what.c_str(), (unsigned long long)Y52s_Sid_Of_Handle(handle),
+	       (int)hr.isOk(), code, timeout, token.size());
+	if (!hr.isOk())
+		printf("y52s: gk verify %s: transport error: %s\n", what.c_str(),
+		       hr.description().c_str());
+	if (token.empty())
+		return false;
+	if (token_out)
+		*token_out = token;
+	return true;
+}
+
+/* Enumerate every gatekeeper password handle this device stores: AOSP keeps
+ * them as <16 hex>.handle next to the synthetic password files, one directory
+ * per user. Nothing device-specific is assumed. */
+struct Y52sHandleCand {
+	userid_t user;
+	std::string path;
+	std::string bytes;
+};
+
+static void Y52s_Collect_Handles(std::vector<Y52sHandleCand>* out) {
+	DIR* users = opendir("/data/system_de");
+	if (users == nullptr)
+		return;
+	struct dirent* ue;
+	while ((ue = readdir(users)) != nullptr) {
+		std::string uname = ue->d_name;
+		if (uname.empty() || uname[0] < '0' || uname[0] > '9')
+			continue;
+		std::string dir = "/data/system_de/" + uname + "/spblob";
+		DIR* d = opendir(dir.c_str());
+		if (d == nullptr)
+			continue;
+		struct dirent* e;
+		while ((e = readdir(d)) != nullptr) {
+			std::string name = e->d_name;
+			if (name.size() < 8 ||
+			    name.compare(name.size() - 7, 7, ".handle") != 0)
+				continue;
+			Y52sHandleCand c;
+			c.user = (userid_t)strtol(uname.c_str(), nullptr, 10);
+			c.path = dir + "/" + name;
+			if (!android::base::ReadFileToString(c.path, &c.bytes) ||
+			    c.bytes.size() < 9)
+				continue;
+			printf("y52s: gk handle %s (user %d) -> sid=0x%llx (%zu bytes)\n",
+			       c.path.c_str(), (int)c.user,
+			       (unsigned long long)Y52s_Sid_Of_Handle(c.bytes),
+			       c.bytes.size());
+			out->push_back(c);
+		}
+		closedir(d);
+	}
+	closedir(users);
+}
