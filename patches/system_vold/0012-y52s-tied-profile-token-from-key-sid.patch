+/* Mint a token for want_sid by verifying the enrolled handle that carries it
+ * with the owner credential. Returns the raw 69-byte token. */
+static bool Y52s_Mint_Token(const userid_t owner_id, const std::string& credential,
+		uint64_t want_sid, std::string* token_out) {
+	char spblob_dir[PATH_MAX];
+	snprintf(spblob_dir, sizeof(spblob_dir), "/data/system_de/%d/spblob/",
+			(int)owner_id);
+	std::string spblob_path = spblob_dir;
+	KeystoreInfo keystore_info;
+	std::string handle_str = keystore_info.getHandle(owner_id);
+	password_data_struct pwd;
+	pwd.salt = NULL;
+	pwd.salt_len = 0;
+	pwd.password_handle = NULL;
+	pwd.handle_len = 0;
+	if (!Get_Password_Data(spblob_path, handle_str, &pwd)) {
+		printf("y52s: mint: no password data under %s\n", spblob_path.c_str());
+		return false;
+	}
+	const std::string cred =
+		(credential == "!") ? std::string("default-password") : credential;
+	unsigned char password_token[PASSWORD_TOKEN_SIZE];
+	memset(password_token, 0, PASSWORD_TOKEN_SIZE);
+	if (!Get_Password_Token(&pwd, cred, &password_token[0])) {
+		printf("y52s: mint: password token derivation failed\n");
+		if (pwd.salt) free(pwd.salt);
+		if (pwd.password_handle) free(pwd.password_handle);
+		return false;
+	}
+	void* gk_pwd_token = PersonalizedHashBinary(PERSONALIZATION_USER_GK_AUTH,
+			(char*)&password_token[0], PASSWORD_TOKEN_SIZE);
+	if (pwd.salt) free(pwd.salt);
+	if (pwd.password_handle) free(pwd.password_handle);
+	if (gk_pwd_token == NULL) {
+		printf("y52s: mint: gatekeeper password hash failed\n");
+		return false;
+	}
+	std::string gk_password((const char*)gk_pwd_token, SHA512_DIGEST_LENGTH);
+	free(gk_pwd_token);
+
+	std::vector<Y52sHandleCand> cands;
+	Y52s_Collect_Handles(&cands);
+	bool ok = false;
+	for (size_t i = 0; i < cands.size() && !ok; ++i) {
+		if (Y52s_Sid_Of_Handle(cands[i].bytes) != want_sid) {
+			printf("y52s: mint: skipping %s (sid 0x%llx != required 0x%llx)\n",
+			       cands[i].path.c_str(),
+			       (unsigned long long)Y52s_Sid_Of_Handle(cands[i].bytes),
+			       (unsigned long long)want_sid);
+			continue;
+		}
+		ok = Y52s_Gk_Verify(owner_id, cands[i].path, cands[i].bytes,
+				gk_password, token_out);
+	}
+	if (!ok)
+		printf("y52s: mint: no handle carries sid 0x%llx\n",
+		       (unsigned long long)want_sid);
+	return ok;
+}
+
+/* The profile's parent user, straight out of its user record. */
+static userid_t Y52s_Profile_Parent(userid_t user_id) {
+	char path[PATH_MAX];
+	snprintf(path, sizeof(path), "/data/system/users/%d.xml", (int)user_id);
+	std::string xml;
+	if (!android::base::ReadFileToString(path, &xml))
+		return 0;
+	size_t at = xml.find("profileGroupId=\"");
+	if (at == std::string::npos)
+		return 0;
+	at += strlen("profileGroupId=\"");
+	return (userid_t)strtol(xml.c_str() + at, nullptr, 10);
+}
+
+/* Every user on this device that carries a tied-profile lock file. */
+static std::vector<userid_t> Y52s_Profile_Users() {
+	std::vector<userid_t> users;
+	DIR* d = opendir("/data/system_de");
+	if (d == nullptr)
+		return users;
+	struct dirent* e;
+	while ((e = readdir(d)) != nullptr) {
+		std::string name = e->d_name;
+		if (name.empty() || name[0] < '0' || name[0] > '9')
+			continue;
+		userid_t uid = (userid_t)strtol(name.c_str(), nullptr, 10);
+		char lock[PATH_MAX];
+		snprintf(lock, sizeof(lock), "/data/system/users/%d/gatekeeper.profile.key",
+				(int)uid);
+		struct stat st;
+		if (stat(lock, &st) == 0 && st.st_size > 12)
+			users.push_back(uid);
+	}
+	closedir(d);
+	return users;
+}
